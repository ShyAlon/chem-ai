{$PUBLIC_HOST} {
	encode zstd gzip
	handle /api/management/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000 {
			header_up X-HomeChem-Client-IP {remote_host}
		}
	}
	handle /api/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy api:8000 {
			header_up X-HomeChem-Client-IP {remote_host}
		}
	}
	handle /mcp {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		@worker path /sw.js /index.html / /how-it-works /how-it-works/
		header @worker Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
